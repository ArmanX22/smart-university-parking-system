# ==============================================================================
# SMART UNIVERSITY PARKING MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ==============================================================================

# Database: TiDB Cloud (MySQL-compatible)
# Example: mysql://<user>.<prefix>:<password>@<host>:4000/<database>?sslaccept=strict
DATABASE_URL="mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/smart_parking?sslaccept=strict"

# Authentication: Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generate-32-char-random-secret-here"
# Google OAuth Credentials (console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Development / Academic Demo Credentials Mode
# Set to "true" to allow switching between Driver, Attendant, and Admin personas in local dev without Google OAuth
ENABLE_DEMO_AUTH="true"

# Vercel Cron Security Secrets (use independent random values)
CRON_SECRET="your-cron-secret-token-for-expiry-endpoint"
RESET_SECRET="your-nightly-demo-reset-secret"

# Firebase Cloud Messaging (FCM) - Server Side (Firebase Admin SDK)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Cloud Messaging (FCM) - Client Side Web Push
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDummyApiKeyForClient"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-public-web-push-vapid-key"

# Google AI Studio (Gemini 1.5 Flash API Key)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."
