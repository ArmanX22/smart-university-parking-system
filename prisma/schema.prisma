generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  DRIVER
  ATTENDANT
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  PENDING_ARRIVAL        // Slot reserved; arrival grace countdown running
  ACTIVE                 // Attendant/QR verified arrival; parking duration active
  EXPIRED_AWAITING_EXIT  // Parking duration elapsed; vehicle still physically present
  COMPLETED              // Attendant verified departure; slot released
  CANCELLED              // User cancelled before arrival grace expired
  NO_SHOW                // Arrival grace period elapsed without vehicle arrival
}

enum WaitingStatus {
  WAITING
  ALLOCATED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  BOOKING_CONFIRMED
  ARRIVAL_REMINDER
  NO_SHOW_CANCELLED
  VEHICLE_ARRIVED
  PARKING_WARNING
  PARKING_EXPIRED
  VEHICLE_EXIT
  WAITING_ALLOCATED
  SYSTEM_ALERT
}

// -----------------------------------------------------------------------------
// USER & AUTHENTICATION (Auth.js / NextAuth compatible)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(DRIVER)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  vehicles             Vehicle[]
  bookings             Booking[]
  waitingListEntries   WaitingListEntry[]
  devicePushTokens     DevicePushToken[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  attendantAssignments AttendantAssignment[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// VEHICLE INVENTORY
// -----------------------------------------------------------------------------

model VehicleCategory {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "CAR", "BUS", "MOTORCYCLE", "OTHER"
  codePrefix  String   @unique // e.g. "C", "B", "M", "O"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  durationPolicy     DurationPolicy?
  slots              ParkingSlot[]
  vehicles           Vehicle[]
  waitingListEntries WaitingListEntry[]
}

model DurationPolicy {
  id                     String   @id @default(cuid())
  categoryId             String   @unique
  arrivalGraceMinutes    Int      @default(15) // Allowed window to arrive after reserving
  parkingDurationMinutes Int      @default(15) // Allowed parking time after arrival check-in
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  category VehicleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id           String   @id @default(cuid())
  userId       String
  categoryId   String
  licensePlate String   @unique
  makeModel    String?
  color        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category VehicleCategory @relation(fields: [categoryId], references: [id])
  bookings Booking[]

  @@index([userId])
  @@index([categoryId])
}

// -----------------------------------------------------------------------------
// PARKING AREAS & SLOTS
// -----------------------------------------------------------------------------

model ParkingArea {
  id          String   @id @default(cuid())
  name        String   // e.g. "North Campus Lot"
  code        String   @unique // e.g. "NORTH-LOT"
  description String?
  totalSlots  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots                ParkingSlot[]
  attendantAssignments AttendantAssignment[]
  waitingListEntries   WaitingListEntry[]
}

model AttendantAssignment {
  id         String   @id @default(cuid())
  userId     String
  areaId     String
  assignedAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area ParkingArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId])
  @@index([areaId])
}

model ParkingSlot {
  id         String     @id @default(cuid())
  areaId     String
  categoryId String
  slotNumber String     // e.g. "C01", "B02", "M03", "O01"
  status     SlotStatus @default(AVAILABLE)
  version    Int        @default(0) // Optimistic locking counter
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  area     ParkingArea     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  category VehicleCategory @relation(fields: [categoryId], references: [id])
  bookings Booking[]

  @@unique([areaId, slotNumber])
  @@index([status])
  @@index([categoryId])
  @@index([areaId])
}

// -----------------------------------------------------------------------------
// RESERVATIONS & BOOKINGS
// -----------------------------------------------------------------------------

model Booking {
  id                     String        @id @default(cuid())
  bookingCode            String        @unique // e.g. "BK-984210"
  userId                 String
  vehicleId              String
  slotId                 String
  status                 BookingStatus @default(PENDING_ARRIVAL)

  // UTC Timestamps
  arrivalExpiresAt       DateTime      // Due time for vehicle arrival
  enteredAt              DateTime?     // Actual check-in timestamp
  parkingExpiresAt       DateTime?     // Due time for parking limit
  exitedAt               DateTime?     // Actual departure timestamp

  // Snapshot of applied policies
  appliedGraceMinutes    Int
  appliedDurationMinutes Int

  // Security token for QR check-in & check-out validation
  qrCodeSecret           String        @default(cuid())

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id])
  slot    ParkingSlot @relation(fields: [slotId], references: [id])

  // Critical performance indexes for Vercel Cron batch scans
  @@index([status, arrivalExpiresAt])
  @@index([status, parkingExpiresAt])
  @@index([userId])
  @@index([slotId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// FAIR QUEUE / WAITING LIST
// -----------------------------------------------------------------------------

model WaitingListEntry {
  id                 String        @id @default(cuid())
  userId             String
  areaId             String
  categoryId         String
  status             WaitingStatus @default(WAITING)
  allocatedBookingId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  area     ParkingArea     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  category VehicleCategory @relation(fields: [categoryId], references: [id])

  @@index([areaId, categoryId, status, createdAt])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS & PUSH TOKENS
// -----------------------------------------------------------------------------

model DevicePushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique @db.VarChar(512)
  platform   String   @default("web")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String           @db.Text
  type      NotificationType
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// AUDIT LOG
// -----------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String   // e.g. "SLOT_RESERVED", "VEHICLE_CHECKED_IN", "DURATION_POLICY_UPDATED"
  entityType   String   // e.g. "Booking", "ParkingSlot", "DurationPolicy"
  entityId     String?
  metadataJson String?  @db.Text
  ipAddress    String?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
